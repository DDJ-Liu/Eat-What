    {
      "name": "description",
      "csvColumn": "description",
      "type": "string",
      "required": false,
      "description": "状态说明，填写供策划阅读的文字。"
    },
    {
      "name": "switch_source",
      "csvColumn": "switch_source",
      "type": "string",
      "required": false,
      "description": "说明性切换来源，程序不读取。"
    },
    {
      "name": "comment",
      "csvColumn": "comment",
      "type": "string",
      "required": false,
